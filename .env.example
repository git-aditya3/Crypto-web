# Use demo for UI development, ml for real hourly market data and forecasts.
BTC_ORACLE_MODE=ml
# Required to trigger POST /api/retrain on a hosted instance.
TEAM_A_ADMIN_TOKEN=replace-with-a-long-random-secret
# Pull fresh candles every 5 minutes and refit models every 6 hours.
MARKET_REFRESH_SECONDS=300
MODEL_RETRAIN_SECONDS=21600
LOG_LEVEL=INFO
PORT=5000
